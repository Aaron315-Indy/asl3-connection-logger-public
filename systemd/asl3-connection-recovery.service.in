[Unit]
Description=ASL3 Connection Logger Startup Recovery
After=asterisk.service
PartOf=asterisk.service

[Service]
Type=oneshot
User=asterisk
Group=asterisk
WorkingDirectory=/opt/asl3-connection-logger
ExecStart=/opt/asl3-connection-logger/.venv/bin/python /opt/asl3-connection-logger/scripts/asl3-startup-recover --node @NODE@ --apply
TimeoutStartSec=30

[Install]
WantedBy=asterisk.service
